# Required
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_URL=https://stewardbridge.com
ADMIN_EMAIL=johnademuyiwa1@gmail.com

# External agent - the agent itself is NOT bundled in this repository
STEWARD_BRIDGE_AGENT_WEBHOOK_URL=https://your-agent.example/webhook
STEWARD_BRIDGE_AGENT_WEBHOOK_SECRET=replace-with-agent-shared-secret
WEBHOOK_SIGNING_SECRET=replace-with-agent-pull-secret

# Required for all human user sign-in (Google OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional OpenRouter fallback if you choose to use the internal AI route
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# S3-compatible private object storage (R2, S3, or compatible provider)
STORAGE_ENDPOINT=https://YOUR_S3_COMPATIBLE_ENDPOINT
STORAGE_REGION=auto
STORAGE_BUCKET=stewardbridge-private-documents
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
